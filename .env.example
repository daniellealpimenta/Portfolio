# Copie para .env e preencha. Nunca versione o .env.

# Banco de dados (Neon): Dashboard > Connect > marque "Connection pooling" e copie a URL
DATABASE_URL=postgresql://usuario:senha@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require

# Único e-mail que pode entrar no /admin (tem que ser o e-mail do seu usuário no banco)
ADMIN_EMAIL=danielleal54321@gmail.com

# Chave usada para assinar o token de sessão do /admin (gere com: python -c "import secrets; print(secrets.token_hex(32))")
SESSION_SECRET_KEY=ae46ed7224db692eca4b8b2fc20f20fdeb36cb4dd37e59d60fe2842ab34e3e93

# true em produção (HTTPS); false em dev local (http://localhost)
COOKIE_SECURE=false

# Origens do frontend que podem chamar a API com cookie (separadas por vírgula)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# E-mail (código de login e formulário de contato). Gmail: use uma "senha de app".
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=danielleal54321@gmail.com
SMTP_PASSWORD=icli uzyn kzgl vbei

